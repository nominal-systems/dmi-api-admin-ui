<div class="flex">
  <div class="text-sm font-semibold text-gray-500 dark:text-gray-300">
    <span x-text="message"></span>
  </div>
</div>
<template x-if="reportId">
  <div class="mt-3 cursor-default" @click.stop
       x-data="republishPanel({ reportId, sourceEventId: null, integrationId: data.integrationId, type: 'report:updated' })">
    {{> events/republish-panel }}
  </div>
</template>
